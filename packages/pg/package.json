{
	"name": "@hejbro/pg",
	"version": "0.0.0",
	"description": "Vanilla node-postgres driver for hejbro's query layer.",
	"license": "MIT",
	"type": "module",
	"private": true,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/quickstart-now/hejbro",
		"directory": "packages/pg"
	},
	"homepage": "https://github.com/quickstart-now/hejbro#readme",
	"bugs": {
		"url": "https://github.com/quickstart-now/hejbro/issues"
	},
	"keywords": [
		"postgres",
		"postgresql",
		"node-postgres",
		"driver"
	],
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:integration": "vitest run --config vitest.integration.config.ts"
	},
	"peerDependencies": {
		"pg": "^8.23.0"
	},
	"dependencies": {
		"@hejbro/query": "workspace:*"
	},
	"devDependencies": {
		"@hejbro/core": "workspace:*",
		"@types/pg": "^8.23.1",
		"@vitest/coverage-v8": "catalog:",
		"pg": "^8.23.0",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
