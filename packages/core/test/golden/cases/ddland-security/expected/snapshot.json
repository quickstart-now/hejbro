		"policy:ddland.comments.comments_read_visible": {
			"command": "select",
			"name": "comments_read_visible",
			"roles": [
				"anon"
			],
			"schema": "ddland",
			"table": "comments",
			"using": "(\"ddland\".\"comments\".\"deleted_at\" is null) and exists (select 1 from \"ddland\".\"posts\" where (\"ddland\".\"posts\".\"id\" = \"ddland\".\"comments\".\"post_id\") and (\"ddland\".\"posts\".\"status\" = 'published') and (\"ddland\".\"posts\".\"published_at\" <= now()))"
		},
		"policy:ddland.post_translations.post_translations_read_published": {
			"command": "select",
			"name": "post_translations_read_published",
			"roles": [
				"anon"
			],
			"schema": "ddland",
			"table": "post_translations",
			"using": "exists (select 1 from \"ddland\".\"posts\" where (\"ddland\".\"posts\".\"id\" = \"ddland\".\"post_translations\".\"post_id\") and (\"ddland\".\"posts\".\"status\" = 'published') and (\"ddland\".\"posts\".\"published_at\" <= now()))"
		},
		"policy:ddland.posts.posts_read_published": {
			"command": "select",
			"name": "posts_read_published",
			"roles": [
				"anon"
			],
			"schema": "ddland",
			"table": "posts",
			"using": "\"ddland\".\"posts\".\"status\" = 'published'"
		},
