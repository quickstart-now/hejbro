{
	"name": "hejbro",
	"version": "0.0.0",
	"description": "TypeScript-native Postgres schema & RPC management. Declare everything in TypeScript, generate deterministic migration SQL.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/quickstart-now/hejbro",
		"directory": "packages/cli"
	},
	"homepage": "https://github.com/quickstart-now/hejbro#readme",
	"bugs": {
		"url": "https://github.com/quickstart-now/hejbro/issues"
	},
	"keywords": [
		"postgres",
		"postgresql",
		"schema",
		"migrations",
		"cli",
		"typescript"
	],
	"bin": {
		"hejbro": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"prepack": "pnpm build"
	},
	"dependencies": {
		"@hejbro/core": "workspace:*",
		"citty": "^0.2.2",
		"jiti": "^2.7.0",
		"tinyglobby": "^0.2.17",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@hejbro/supabase": "workspace:*",
		"tsdown": "catalog:",
		"vitest": "catalog:"
	}
}
