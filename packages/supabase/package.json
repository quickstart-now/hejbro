{
	"name": "@hejbro/supabase",
	"version": "0.2.0-pre.2",
	"description": "Supabase provider preset for hejbro: auth expression helpers, storage buckets, role/grant presets, reserved-schema protection.",
	"license": "Apache-2.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/quickstart-now/hejbro",
		"directory": "packages/supabase"
	},
	"homepage": "https://github.com/quickstart-now/hejbro#readme",
	"bugs": {
		"url": "https://github.com/quickstart-now/hejbro/issues"
	},
	"keywords": [
		"postgres",
		"postgresql",
		"supabase",
		"schema",
		"migrations",
		"typescript"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"NOTICE"
	],
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"prepack": "pnpm build"
	},
	"dependencies": {
		"@hejbro/core": "workspace:*",
		"@hejbro/query": "workspace:*"
	},
	"devDependencies": {
		"@types/pg": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"pg": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
