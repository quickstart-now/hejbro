{
	"name": "hejbro-monorepo",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"test": "turbo run test && turbo run test:types",
		"test:coverage": "turbo run test:coverage",
		"format": "biome format --write .",
		"check": "biome check .",
		"smoke:pack-install": "bash scripts/pack-install-smoke.sh",
		"check:first-release-version": "node scripts/check-first-release-version.mjs",
		"check:next-marker": "node scripts/check-next-marker.mjs",
		"check:diagnostic-xref": "node scripts/check-diagnostic-xref.mjs",
		"check:bans": "node scripts/check-bans.mjs",
		"check:fixed-group": "node scripts/check-fixed-group.mjs",
		"check:client-ranges": "node scripts/check-client-ranges.mjs",
		"check:modified-titles": "node scripts/check-modified-titles.mjs",
		"check:pr-changeset": "node scripts/check-pr-changeset.mjs",
		"check:pnpm-publish-tool": "node scripts/verify-pnpm-publish-tool.mjs",
		"check:crap": "node scripts/crap-gate.mjs",
		"check:tasktime": "node scripts/tasktime-badges.mjs",
		"check:blackbox": "node .blackbox/bin/blackbox.mjs check",
		"blackbox": "node .blackbox/bin/blackbox.mjs",
		"regen:examples": "bash scripts/regen-examples.sh",
		"verify:supabase-image": "bash scripts/verify-supabase-image.sh",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "pnpm build && changeset publish $([ -f .changeset/pre.json ] && echo --tag pre)",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@changesets/cli": "^3.0.1",
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@manypkg/get-packages": "^3.1.0",
		"husky": "^9.1.7",
		"turbo": "^2.9.8",
		"typescript": "catalog:"
	},
	"packageManager": "pnpm@10.19.0",
	"engines": {
		"node": ">=22.18.0"
	},
	"pnpm": {
		"overrides": {
			"fast-uri": "^3.1.6"
		}
	}
}
